OPENROUTER_API_KEY=your_openrouter_key_here
SHELBY_API_KEY=paste_your_shelby_api_key_here
# Optional. Only needed if Shelby's faucet starts requiring an auth token.
SHELBY_FAUCET_AUTH_TOKEN=

# Private keys stay only in .env.local. Never commit real values.
APTOS_PRIVATE_KEY=paste_your_aptos_private_key_here

# Clerk handles user authentication.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=paste_your_clerk_publishable_key_here
CLERK_SECRET_KEY=paste_your_clerk_secret_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app
